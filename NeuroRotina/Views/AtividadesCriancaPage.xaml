<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.AtividadesCriancaPage"
    Title="ATIVIDADES">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Label
                Text="ATIVIDADES"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="MINHAS TAREFINHAS"
                FontSize="20"
                HorizontalOptions="Center" />

            <VerticalStackLayout
                x:Name="ListaAtividades"
                Spacing="15" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>