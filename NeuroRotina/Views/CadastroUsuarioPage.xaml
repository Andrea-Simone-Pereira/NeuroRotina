<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.CadastroUsuarioPage"
    Title="CRIAR CONTA">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="NEUROROTINA"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="CRIAR CONTA DO ADULTO"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Entry
                x:Name="txtNome"
                Placeholder="Nome completo" />

            <Entry
                x:Name="txtEmail"
                Placeholder="E-mail"
                Keyboard="Email" />

            <Entry
                x:Name="txtSenha"
                Placeholder="Senha"
                IsPassword="True" />

            <Entry
                x:Name="txtConfirmarSenha"
                Placeholder="Confirmar senha"
                IsPassword="True" />

            <Button
                Text="CRIAR CONTA"
                Clicked="BtnCriarConta_Clicked" />

            <Label
                x:Name="lblMensagem"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>