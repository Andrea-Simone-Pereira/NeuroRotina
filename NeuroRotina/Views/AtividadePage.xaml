<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.AtividadePage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="NOVA ATIVIDADE"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="ROTINA"
                FontSize="16"
                FontAttributes="Bold" />

            <Label
                x:Name="lblRotina"
                Text="Rotina"
                FontSize="22"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="DESCRIÇÃO DA ATIVIDADE"
                FontSize="16"
                FontAttributes="Bold" />

            <Editor
                x:Name="txtDescricao"
                Placeholder="Descreva a atividade"
                HeightRequest="120" />

            <HorizontalStackLayout
                Spacing="10">

                <CheckBox
                    x:Name="chkConcluida" />

                <Label
                    Text="CONCLUÍDA"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Button
                Text="CADASTRAR ATIVIDADE"
                Clicked="BtnCadastrar_Clicked" />

            <Label
                x:Name="lblMensagem"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>