<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.ListaCriancasPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="Minhas Crianças"
                FontSize="28"
                HorizontalOptions="Center" />

            <VerticalStackLayout
                x:Name="ListaCriancas"
                Spacing="10" />

            <Button
                Text="Cadastrar Nova Criança"
                Clicked="BtnNovaCrianca_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>