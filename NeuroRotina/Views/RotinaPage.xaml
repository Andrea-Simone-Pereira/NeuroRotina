<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.RotinaPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                x:Name="lblTituloPagina"
                Text="NOVA ROTINA"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Entry
                x:Name="txtTitulo"
                Placeholder="Título da rotina" />

            <Editor
                x:Name="txtDescricao"
                Placeholder="Descrição da rotina"
                HeightRequest="120" />

            <DatePicker
                x:Name="dtpData" />

            <Button
                x:Name="btnSalvar"
                Text="CADASTRAR ROTINA"
                Clicked="BtnCadastrar_Clicked" />

            <Button
                Text="VER MINHAS ROTINAS"
                Clicked="BtnVerRotinas_Clicked" />

            <Label
                x:Name="lblMensagem"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>