<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NeuroRotina.Views.LoginPage"
    Title="LOGIN">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="NEUROROTINA"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="LOGIN DO ADULTO"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Entry
                x:Name="txtEmail"
                Placeholder="E-mail"
                Keyboard="Email" />

            <Entry
                x:Name="txtSenha"
                Placeholder="Senha"
                IsPassword="True" />

            <Button
                Text="ENTRAR"
                Clicked="BtnEntrar_Clicked" />

            <Button
                Text="CRIAR CONTA"
                Clicked="BtnCriarConta_Clicked" />

            <Label
                Text="OU"
                FontSize="14"
                HorizontalOptions="Center" />

            <Button
                Text="ENTRAR COMO CRIANÇA"
                Clicked="BtnEntrarComoCrianca_Clicked" />

            <Label
                x:Name="lblMensagem"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>