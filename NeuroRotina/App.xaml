<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:NeuroRotina.Converters"
             x:Class="NeuroRotina.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InverterBooleanoConverter x:Key="Inverter" />
            <conv:TextoNaoVazioConverter x:Key="TextoNaoVazio" />
            <conv:ProgressoCorConverter x:Key="ProgressoCor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
